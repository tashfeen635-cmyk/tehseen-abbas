# ===== MongoDB (Atlas) =====
# Required for the app to work (production and local dev).
# On Vercel: connect a MongoDB Atlas integration, or add MONGODB_URI manually.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster.mongodb.net/?appName=<app>

# ===== Admin auth =====
# Required for admin login sessions. Set a long random string.
ADMIN_SECRET=change-this-to-a-long-random-string

# Optional: admin username/password. When both are set and no password hash exists
# in the database, they are used as the fallback.
ADMIN_USER=admin
ADMIN_PASSWORD=your-password

# ===== Vercel Blob (image uploads) =====
# Optional for production image uploads. Created when you add a Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
