# ===== Vercel Postgres (Neon) =====
# Required for the app to work (production and local dev).
# On Vercel: connect a "Vercel Postgres" / Neon store and these are auto-injected as
# POSTGRES_URL, POSTGRES_PRISMA_URL, etc. You can also paste the connection string here.
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require
POSTGRES_PRISMA_URL=
DATABASE_URL=
POSTGRES_URL_NON_POOLING=

# ===== Admin auth =====
# Required for admin login sessions. Set a long random string.
ADMIN_SECRET=change-this-to-a-long-random-string

# Optional: admin username/password. When both are set, they take precedence over
# the credentials stored in the database.
ADMIN_USER=admin
ADMIN_PASSWORD=your-password

# ===== Vercel Blob (image uploads) =====
# Optional for production image uploads. Created when you add a Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
